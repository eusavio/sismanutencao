<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import java.lang.*?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ghulam.setting.SettingController"
            prefHeight="522.0" prefWidth="761.0">
    <children>
        <!-- Cabeçalho (vazio, como na referência) -->
        <AnchorPane prefHeight="56.0" styleClass="flatAnchorWithEffect1" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="6.0" />

        <!-- Cartão centralizado: faixa de título + caixa marrom -->
        <StackPane AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="76.0">
            <children>
                <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="560.0">
                    <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="56.0" styleClass="settingTitle" text="Settings" />
                        <VBox alignment="TOP_CENTER" spacing="30.0" styleClass="settingBody">
                            <padding>
                                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                            <children>
                                <GridPane alignment="CENTER" hgap="20.0" vgap="18.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="10.0" prefWidth="200.0" />
                                        <ColumnConstraints minWidth="10.0" prefWidth="190.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Menu Unhover Color:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <JFXComboBox prefWidth="190.0" styleClass="settingCombo" value="Default" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Default" />
                                                </FXCollections>
                                            </items>
                                        </JFXComboBox>
                                        <Label text="Menu Hover Color:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <JFXComboBox prefWidth="190.0" styleClass="settingCombo" value="Default" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Default" />
                                                </FXCollections>
                                            </items>
                                        </JFXComboBox>
                                        <Label text="Menu Active Color:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <JFXComboBox prefWidth="190.0" styleClass="settingCombo" value="Default" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Default" />
                                                </FXCollections>
                                            </items>
                                        </JFXComboBox>
                                        <Label text="Menu Text Color:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <JFXComboBox prefWidth="190.0" styleClass="settingCombo" value="Default" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Default" />
                                                </FXCollections>
                                            </items>
                                        </JFXComboBox>
                                    </children>
                                </GridPane>
                                <!-- Botões sem ação (tela apenas visual por enquanto) -->
                                <HBox alignment="CENTER" spacing="70.0">
                                    <children>
                                        <JFXButton prefWidth="110.0" styleClass="allButtons" text="Reset" />
                                        <JFXButton prefWidth="110.0" styleClass="allButtons" text="Apply" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
